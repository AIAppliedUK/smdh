# SMDH Development Environment Configuration
# Copy this file to terraform.tfvars and update with your values

# AWS Configuration
aws_region  = "eu-west-2"
environment = "dev"

# Project Settings
project_name = "smdh"

# ========================================
# MANDATORY TAGS (Required for deployment)
# ========================================

owner       = "Platform-Team"        # Team or individual responsible
cost_center = "ENG-001"              # Billing allocation code
deployed_by = "john.smith@company.com"  # Who deployed this

# ========================================
# Compliance and Classification
# ========================================

data_classification    = "Internal"  # Public, Internal, Confidential, Restricted
compliance_requirement = "None"      # GDPR, ISO27001, etc.
backup_policy         = "Daily"      # None, Daily, Weekly, Monthly

# ========================================
# Business and Operational
# ========================================

business_unit    = "Engineering"
application_name = "SMDH"
service_tier     = "High"  # Critical, High, Medium, Low

# Logging and Retention
log_retention_days       = 30  # Lower retention for dev
kinesis_retention_hours  = 24  # Minimum retention

# Snowflake Configuration
# Get these values from your Snowflake account
snowflake_account_id   = ""  # AWS account ID that Snowflake uses
snowflake_external_id  = ""  # External ID for cross-account role trust
snowflake_region       = "eu-west-2"

# Alerting
alert_email = "dev-team@yourcompany.com"

# Monitoring
enable_monitoring         = true
enable_deletion_protection = false  # Allow easy cleanup in dev

# Tenants - Example configuration for testing
tenants = {
  test_tenant = {
    name             = "Test Tenant Ltd"
    num_sites        = 2
    retention_days   = 90
    warehouse_size   = "XSMALL"
    contact_email    = "test@yourcompany.com"
    sensors_per_site = 5
  }
}

# Additional Tags
tags = {
  CostCenter = "Engineering"
  Owner      = "Platform Team"
  Purpose    = "Development"
}
