          <mxGeometry x="50" y="448" width="420" height="18" as="geometry" />
        </mxCell>
        <mxCell id="note" value="OSM supports WiFi MQTT with user/pass&#xa;but NOT X.509 certificates.&#xa;ChirpStack bridges to AWS using X.509." style="shape=note;whiteSpace=wrap;html=1;backgroundOutline=1;darkOpacity=0.05;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;spacingLeft=5;" vertex="1" parent="1">
