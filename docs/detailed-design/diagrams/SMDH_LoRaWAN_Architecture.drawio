        <mxCell id="leg-a" value="━━  Option A: LoRaWAN → Gateway (Built-in NS) → AWS IoT Core (X.509)" style="text;html=1;strokeColor=none;fillColor=none;align=left;fontSize=10;fontColor=#82b366;" parent="1" vertex="1">
