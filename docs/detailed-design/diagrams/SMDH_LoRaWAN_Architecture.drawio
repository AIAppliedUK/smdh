        <mxCell id="snowflake-container" value="Snowflake Cloud" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;fontColor=#333333;verticalAlign=top;fontStyle=1;fontSize=14;spacingTop=5;dashed=1;" parent="1" vertex="1">
          <mxGeometry x="470" y="280" width="200" height="150" as="geometry" />
