        <mxCell id="payload2" value="2. Gateway Enriched&#xa;{&#xa;  &quot;devEUI&quot;: &quot;a840410000000123&quot;,&#xa;  &quot;gatewayID&quot;: &quot;ug65-site-001&quot;,&#xa;  &quot;rxInfo&quot;: [{&#xa;    &quot;rssi&quot;: -85,&#xa;    &quot;snr&quot;: 8.5&#xa;  }],&#xa;  &quot;object&quot;: {&#xa;    &quot;temperature&quot;: 22.5&#xa;  }&#xa;}" style="text;html=1;strokeColor=#01579B;fillColor=#E1F5FE;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontFamily=Courier New;spacingLeft=10;" parent="1" vertex="1">
