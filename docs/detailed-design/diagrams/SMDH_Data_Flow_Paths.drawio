        <mxCell id="step2" value="2. Lambda Validation&#xa;• Lookup tenant from API key&#xa;• Validate payload schema&#xa;• Check tenant match&#xa;• Generate JWT token" style="text;html=1;strokeColor=none;fillColor=#FFF9C4;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=10;" parent="1" vertex="1">
