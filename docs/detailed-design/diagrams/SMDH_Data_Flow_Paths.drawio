        <mxCell id="payload4" value="4. Kinesis Record&#xa;{&#xa;  &quot;Data&quot;: &lt;base64 encoded&gt;,&#xa;  &quot;PartitionKey&quot;: &quot;company_a&quot;,&#xa;  &quot;SequenceNumber&quot;: &quot;495...&quot;,&#xa;  &quot;ApproximateArrivalTimestamp&quot;: ...&#xa;}" style="text;html=1;strokeColor=#7B1FA2;fillColor=#F3E5F5;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;fontFamily=Courier New;spacingLeft=10;" parent="1" vertex="1">
