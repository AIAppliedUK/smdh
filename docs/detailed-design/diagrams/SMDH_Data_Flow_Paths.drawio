        <mxCell id="step1" value="1. API Gateway&#xa;• Validate API key exists&#xa;• Check rate limits&#xa;• Log request" style="text;html=1;strokeColor=none;fillColor=#FFCDD2;align=left;verticalAlign=top;whiteSpace=wrap;rounded=1;fontSize=10;spacingLeft=10;" parent="1" vertex="1">
